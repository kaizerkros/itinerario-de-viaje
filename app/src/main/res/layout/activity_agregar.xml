<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/EstiloTituloViaje" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/crear_itinerario" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/destino" />
        <EditText android:id="@+id/edtDestino" style="@style/EstiloCampoViaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/destino_hint" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/fecha_inicio" />
        <EditText android:id="@+id/edtFechaInicio" style="@style/EstiloCampoViaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/fecha_inicio_hint" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/duracion" />
        <EditText android:id="@+id/edtDuracion" style="@style/EstiloCampoViaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/duracion_hint" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/presupuesto" />
        <EditText android:id="@+id/edtPresupuesto" style="@style/EstiloCampoViaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/presupuesto_hint" android:inputType="number" />
        <Button android:id="@+id/btnGuardarViaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/crear_itinerario" />
    </LinearLayout>
</ScrollView>

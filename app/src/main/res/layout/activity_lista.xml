<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <TextView style="@style/EstiloTituloViaje" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mis_viajes" />
        <Button android:id="@+id/btnAgregar" style="@style/EstiloBotonViaje" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/agregar" />
        <Button android:id="@+id/btnPerfil" style="@style/EstiloBotonViaje" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/perfil" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/contenedorViajes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" />
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ItinerarioViaje" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primario</item>
        <item name="android:colorPrimaryDark">@color/primario_variante</item>
        <item name="android:colorAccent">@color/primario</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto_principal</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/fondo</item>
    </style>
    <style name="EstiloTituloViaje">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primario</item>
    </style>
    <style name="EstiloCampoViaje">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@color/fondo_tarjeta</item>
    </style>
    <style name="EstiloBotonViaje" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/texto_boton</item>
    </style>
</resources>
